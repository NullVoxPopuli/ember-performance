{
  "name": "ember-beta",
  "version": "0.0.0",
  "private": true,
  "description": "Small description for ember-beta goes here",
  "repository": "",
  "license": "MIT",
  "author": "",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build:prod": "pnpm _syncPnpm && vite build",
    "build:dev": "pnpm _syncPnpm && vite build --mode development",
    "start": "pnpm _syncPnpm && NODE_NO_WARNINGS=1 concurrently 'vite' 'pnpm _syncPnpm --watch' --names 'serve,inject'",
    "_syncPnpm": "pnpm sync-dependencies-meta-injected"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/runtime": "^7.29.7",
